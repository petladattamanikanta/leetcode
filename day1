2000.class Solution(object):
    def reversePrefix(self, word, ch):
        a = list(word)
        z = []

        if ch not in word:
            return word

        b = 0
        for i in range(len(a)):
            z.append(a[i])
            b += 1

            if a[i] == ch:
                break

        l=z[::-1]
        a[:b] = l

        return "".join(a)

        


